{
  "name": "@muhammad-awd/cxws-design-system",
  "version": "0.8.0",
  "description": "Presentational UI components and design tokens extracted from the CloudX customer portal.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./tailwind-theme.css": "./dist/tailwind-theme.css",
    "./tailwind.css": "./dist/tailwind.css"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "prepare": "npm run build",
    "build": "vite build && tsc -p tsconfig.build.json && cp src/tokens.css dist/tokens.css && cp src/tailwind-theme.css dist/tailwind-theme.css && cp src/styles.css dist/tailwind.css",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "oxfmt ."
  },
  "peerDependencies": {
    "react": ">=19 <20",
    "react-dom": ">=19 <20"
  },
  "dependencies": {
    "lucide-react": "^1.78.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.30.0",
    "@typescript-eslint/parser": "^8.30.0",
    "eslint": "^9.0.0",
    "jsdom": "^26.1.0",
    "oxfmt": "^0.76.0",
    "@vitejs/plugin-react": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.1.7",
    "vitest": "^3.2.4"
  }
}
